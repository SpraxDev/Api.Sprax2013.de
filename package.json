{
  "name": "sprax-api",
  "version": "2.0.0-SNAPSHOT",
  "private": true,
  "description": "Public REST API, mainly for Minecraft related stuff (at least for now)",
  "homepage": "https://github.com/SpraxDev/Api.Sprax2013.de#readme",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "rest-api",
    "minecraft",
    "mojang"
  ],
  "author": {
    "name": "Christian Koop",
    "url": "https://github.com/SpraxDev",
    "email": "contact@sprax2013.de"
  },
  "contributors": [
    {
      "name": "Katharina Heidenreich",
      "url": "https://github.com/NudelErde"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpraxDev/Api.Sprax2013.de.git"
  },
  "bugs": {
    "url": "https://github.com/SpraxDev/Api.Sprax2013.de/issues"
  },
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:docker": "docker build --file Containerfile --pull --rm --target prod --tag spraxdev/spraxapi:latest .",
    "build:podman": "podman build --file Containerfile --pull=newer --rm --target prod --tag spraxdev/spraxapi:latest .",

    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --coverage",
    "test:ci": "npm run test -- --ci --randomize --reporters github-actions --reporters summary",
    "type-check": "npm run build -- --noEmit && tsc --project tests/tsconfig.json",

    "dev": "node --watch --env-file .env --loader ts-node/esm --import ./src/sentry-init.ts --enable-source-maps src/main.ts web",
    "dev:queue-worker": "node --watch --env-file .env --loader ts-node/esm --import ./src/sentry-init.ts --enable-source-maps src/main.ts queue-worker",
    "dev:cli": "node --env-file .env --loader ts-node/esm --import ./src/sentry-init.ts --enable-source-maps src/main.ts cli",

    "prisma:generate": "prisma generate --no-engine",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@questdb/nodejs-client": "^4.0.2",
    "@sentry/node": "^8.55.0",
    "@spraxdev/node-commons": "github:SpraxDev/Node-Commons#f09df36c9fcea383c0affa8f8f01df9ac645a1ba",
    "fastify": "^5.5.0",
    "gl": "^8.1.6",
    "ipaddr.js": "^2.2.0",
    "mri": "^1.2.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.3",
    "socks": "^2.8.7",
    "tsyringe": "^4.10.0",
    "undici": "^7.13.0",
    "xxhash-addon": "^2.0.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/gl": "^6.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.17.2",
    "@types/webgl-ext": "^0.0.37",
    "jest": "^30.0.5",
    "jest-mock-extended": "^4.0.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
